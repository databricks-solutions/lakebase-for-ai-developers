# Copy to .env for LOCAL development:  cp .env.example .env
#
# .env is git-ignored and is used ONLY when running locally (IDE / scripts / notebooks on your
# laptop). When this code runs ON Databricks (notebook, job, or Databricks App), authentication
# is AMBIENT — do NOT set DATABRICKS_CONFIG_PROFILE / HOST / TOKEN there. Code should only
# load_dotenv() when NOT running on Databricks (detect via the DATABRICKS_RUNTIME_VERSION env
# var, which is present in DBR / Apps). See CLAUDE.md → "Running locally vs. on Databricks".

# ── Local auth (preferred: OAuth user-to-machine via a CLI profile) ─────────────────────────
# Create the profile once:  databricks auth login --host https://<workspace>.cloud.databricks.com --profile <name>
DATABRICKS_CONFIG_PROFILE=DEFAULT
# Alternative to a profile (not preferred): explicit host + PAT.
# DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
# DATABRICKS_TOKEN=dapi...

# ── Workspace data context (UC) ─────────────────────────────────────────────────────────────
UC_CATALOG=supply_chain
UC_SCHEMA=planner
# Embedding endpoint configured in the LangGraph DatabricksStore (long-term memory + semantic search):
DATABRICKS_EMBEDDING_ENDPOINT=databricks-gte-large-en
# SQL warehouse for DBSQL / synthetic data gen:
# DATABRICKS_WAREHOUSE_ID=

# ── Lakebase (Postgres) — set ONE of instance-name OR autoscaling-endpoint ──────────────────
LAKEBASE_INSTANCE_NAME=
# LAKEBASE_AUTOSCALING_ENDPOINT=
# LAKEBASE_AUTOSCALING_PROJECT=
# LAKEBASE_AUTOSCALING_BRANCH=
LAKEBASE_DATABASE=databricks_postgres
LAKEBASE_AGENT_MEMORY_SCHEMA=supply_chain_planner_memory
# OAuth DB token is generated at runtime via the Databricks SDK (no password in .env).

# ── Genie (Analytics agent — WS3) ───────────────────────────────────────────────────────────
GENIE_SPACE_ID=

# ── Vector Search (Knowledge agent — WS3, P1) ───────────────────────────────────────────────
VECTOR_SEARCH_ENDPOINT=
VECTOR_SEARCH_INDEX=

# ── MLflow ──────────────────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=databricks
MLFLOW_REGISTRY_URI=databricks-uc
# MLFLOW_EXPERIMENT_ID=
