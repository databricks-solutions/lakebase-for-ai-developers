# Copy to .env for LOCAL development:  cp .env.example .env
#
# .env is git-ignored and is used ONLY when running locally (IDE / scripts / notebooks on your
# laptop). When this code runs ON Databricks (notebook, job, or Databricks App), authentication
# is AMBIENT — do NOT set DATABRICKS_CONFIG_PROFILE / HOST / TOKEN there. Code should only
# load_dotenv() when NOT running on Databricks (detect via the DATABRICKS_RUNTIME_VERSION env
# var, which is present in DBR / Apps). See CLAUDE.md → "Running locally vs. on Databricks".

# ── Local auth (preferred: OAuth user-to-machine via a CLI profile) ─────────────────────────
# Create the profile once:  databricks auth login --host https://<workspace>.cloud.databricks.com --profile <name>
DATABRICKS_CONFIG_PROFILE=DEFAULT
# Alternative to a profile (not preferred): explicit host + PAT.
# DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
# DATABRICKS_TOKEN=dapi...

# ── Workspace data context (UC) ─────────────────────────────────────────────────────────────
UC_CATALOG=supply_chain
UC_SCHEMA=planner
# UC volume holding the bronze PDFs (knowledge corpus):
UC_VOLUME=documents
# Embedding endpoint configured in the LangGraph DatabricksStore (long-term memory + semantic search)
# AND the Vector Search index (managed embeddings):
DATABRICKS_EMBEDDING_ENDPOINT=databricks-gte-large-en
# SQL warehouse for DBSQL / synthetic data gen:
# DATABRICKS_WAREHOUSE_ID=

# ── LLM endpoints (Foundation Model APIs) ──────────────────────────────────────────────────
# v1: single inference model wired at all three callsites (router / retrieval / planner).
# Split into fast/mid/strong tiers later if cost requires it — change is .env-only.
LLM_ROUTER_ENDPOINT=databricks-claude-opus-4-8
LLM_RETRIEVAL_ENDPOINT=databricks-claude-opus-4-8
LLM_PLANNER_ENDPOINT=databricks-claude-opus-4-8

# ── Knowledge ingestion (local-only paths used by data/knowledge/01_upload_pdfs.py) ─────────
# Relative to the repo root by default; override to point at a different seed corpus.
# Seed PDFs for the Knowledge agent — vendored in-repo (committed). Override only to point at an
# external copy. Resolved relative to the repo root, so run knowledge scripts from the repo root.
SEED_DATA_PATH=data/knowledge/bronze_documents

# ── Lakebase (Postgres) — set ONE of instance-name OR autoscaling-endpoint ──────────────────
LAKEBASE_INSTANCE_NAME=
# Autoscaling ("projects") form. Set PROJECT + BRANCH (03 syncs into this branch) + ENDPOINT
# (02/04 connect through it). ENDPOINT may be a bare endpoint id — it's combined with PROJECT/BRANCH
# into projects/<project>/branches/<branch>/endpoints/<id> — or the full path (then PROJECT/BRANCH
# are optional). One autoscaling config drives the whole 01→04 run.
# LAKEBASE_AUTOSCALING_PROJECT=
# LAKEBASE_AUTOSCALING_BRANCH=
# LAKEBASE_AUTOSCALING_ENDPOINT=
LAKEBASE_DATABASE=databricks_postgres
LAKEBASE_AGENT_MEMORY_SCHEMA=supply_chain_planner_memory
# In-scope demo planner for the operational ACL (data/operational/). Unset → the current
# Databricks user (so the OBO demo works for whoever generates the data). Set to a fixed email
# for a shared demo where a specific presenter exercises the agent.
# DEMO_PLANNER_USER=presenter@yourco.com
# OAuth DB token is generated at runtime via the Databricks SDK (no password in .env).
# Operational data (data/operational/): Postgres schema for the synced relational tables +
# the pre-seeded pgvector quality_incidents table (kept together so the hybrid query joins them).
LAKEBASE_OPERATIONAL_SCHEMA=public
# UC catalog registered for the Lakebase DB (Synced-Tables target). One-time:
#   databricks postgres create-catalog <name> ...   (see data/operational/README.md)
# LAKEBASE_UC_CATALOG=
# Local-dev only escape hatch — full psycopg URL. NEVER commit a real value.
# LAKEBASE_PG_URL=postgresql://user:pass@host:5432/databricks_postgres?sslmode=require

# ── Genie (Analytics agent — WS3) ───────────────────────────────────────────────────────────
GENIE_SPACE_ID=

# ── Vector Search (Knowledge agent — WS3, P1) ───────────────────────────────────────────────
VECTOR_SEARCH_ENDPOINT=
VECTOR_SEARCH_INDEX=

# ── MLflow ──────────────────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=databricks
MLFLOW_REGISTRY_URI=databricks-uc
# MLFLOW_EXPERIMENT_ID=
